# PostgreSQL Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example for local PostgreSQL (default user is 'postgres', default port is 5432):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashboard_diary"

# If using Vercel Postgres / Neon / Supabase, uncomment and paste below:
# POSTGRES_URL="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
