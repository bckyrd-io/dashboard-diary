{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://next-type-bckyrd-project.vercel.app"
      }
    },
    "preview-lan": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "description": "Local-network build: the app discovers the API server on your LAN at runtime (no baked URL)."
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://next-type-bckyrd-project.vercel.app"
      }
    }
  }
}
